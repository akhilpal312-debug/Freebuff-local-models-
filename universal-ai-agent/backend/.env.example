# ---------------------------------------------------------------------------
# Universal AI Agent — backend environment template.
# Copy to .env (local) or paste into Vercel → Project Settings → Environment.
# Never commit the filled file.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:8000

# CORS is only needed for a browser client; the Android app does not use it.
CORS_ORIGINS=

# --- Database (Neon Postgres or any Postgres) -------------------------------
# SQLAlchemy async URL. Neon: use the *pooled* connection string and keep
# `postgresql+asyncpg://` as the scheme, and add `?ssl=require` if Neon asks for it.
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?ssl=require
# Local development without Postgres:
DATABASE_URL=sqlite+aiosqlite:///./data/dev.db
# Keep true locally (creates tables + agent templates). On Vercel apply
# db/migrations/0001_init.sql once and set this to false.
AUTO_CREATE_TABLES=true

# --- Single workspace owner -------------------------------------------------
# There is no login. Every request runs as this owner; changing it later
# orphans the rows created under the old id. Set before the first run.
SINGLE_USER_ID=00000000-0000-0000-0000-000000000001
SINGLE_USER_EMAIL=owner@localhost
SINGLE_USER_NAME=Owner

# --- Credential encryption --------------------------------------------------
# urlsafe base64 encoded 32-byte Fernet key.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# --- Limits -----------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_BYTES=10485760
PROVIDER_TIMEOUT_SECONDS=120
# On Vercel use /tmp/workspaces: function filesystems are ephemeral, so project
# files and cloned repos do not survive between invocations.
WORKSPACE_ROOT=./data/workspaces
COMMAND_TIMEOUT_SECONDS=300

# --- Web research -----------------------------------------------------------
# Optional paid provider; DuckDuckGo HTML + Wikipedia work without any key.
TAVILY_API_KEY=
RESEARCH_MAX_SOURCES=6
RESEARCH_FETCH_TIMEOUT_SECONDS=20

# --- Coding sandbox ---------------------------------------------------------
# "local" runs allowlisted commands in a jailed workspace directory.
# "docker" needs a Docker daemon and is not available on Vercel.
SANDBOX_MODE=local
SANDBOX_DOCKER_IMAGE=ghcr.io/universal-ai-agent/sandbox:latest

# --- OpenClaw gateway -------------------------------------------------------
# Defaults only; users connect their own gateway from the app and the token is
# stored encrypted per connection.
OPENCLAW_DEFAULT_URL=
OPENCLAW_PROTOCOL_MIN=4
OPENCLAW_PROTOCOL_MAX=4
OPENCLAW_CLIENT_ID=universal-ai-agent-backend
OPENCLAW_CLIENT_VERSION=0.1.0
